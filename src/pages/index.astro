---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import mobile from '../data/mobile-site.json';
import '../styles/home.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const url = (path:string) => base + path;
const categories = ['ドール','ブラインドドール','パーツ','ウィッグ','アイ','ドレス','シューズ','アクセサリー','ツール','その他'];
const socialNames = ['X','facebook','LINE','Instagram','Youtube','X(EN)','rednote','weibo'];
const products = [{slug:'dingdang',name:'DingDang'}, {slug:'happy-fullset',name:'Happy Fullset'}];
---
<Base title="【非公式・選考課題】DOLK バナー掲載デモ" bodyClass="storefront">
  <header class="mobile-header mobile-only" aria-label="DOLK モバイルヘッダー">
    <img class="mobile-menu" src={url(mobile.header[0])} alt="メニュー（掲載イメージ）" width="42" height="35" />
    <img class="mobile-logo" src={url(mobile.header[1])} alt="DOLK" width="146" height="34" />
    <div class="mobile-utilities"><img src={url(mobile.header[2])} alt="ほしいものリスト（掲載イメージ）" width="85" height="50" /><img src={url(mobile.header[3])} alt="カート（掲載イメージ）" width="85" height="50" /></div>
  </header>
  <div class="mobile-shortcuts mobile-only" aria-label="モバイルメニュー掲載イメージ">{mobile.shortcuts.map(item=><img src={url(item.src)} alt={item.alt} width="180" height="90" />)}</div>
  <header class="store-header">
    <div class="welcome"><small>【非公式・選考課題】</small><strong>by Koetsu</strong></div>
    <div class="header-main"><p>ドール・ドール用品専門通販サイト - DOLKSTATION(ドルクステーション)</p><img src={url('images/site/Logo.png')} alt="DOLK STATION" width="225" height="34" /><div class="header-demo-note"><span>【非公式・選考課題】</span>本ページは、バナーの掲載イメージを確認するための静的なモックアップです。<br />「DingDang」「Happy Fullset」の2種類のバナーから、各商品紹介ページへ移動できます。その他のリンク・機能は実装していません。</div></div>
  </header>
  <div class="search-row"><div class="search-display">検索ワードを入力</div><span class="search-category">全カテゴリー　 ▾</span><span class="search-submit">検索</span><span class="search-links">▤ 一覧リスト　 │　 ♥ ほしいものリスト</span></div>
  <div class="campaigns" aria-label="キャンペーン掲載イメージ">
    {['banner_img20260915202422.jpg','banner_img20260915202408.jpg'].map(file=><div class="campaign-strip">{Array.from({length:6},()=> <img src={url('images/site/'+file)} alt="9月23日まで・キャンペーン" />)}</div>)}
  </div>
  <div class="store-layout">
    <aside class="store-sidebar">
      <div class="login-box"><div>会員IDまたはメールアドレス</div><div>パスワード</div><strong>ログイン　 ›</strong><u>ID・パスワードを忘れた方</u></div>
      <h2>カテゴリー <small>検索</small></h2>
      {categories.map(category=><div class="category-row">{category}<span>›</span></div>)}
      <h2 class="teal">メーカー・クリエイター <small>検索</small></h2>
      {['メーカー名','クリエイター名','アイテム','生産国'].map(item=><div class="category-row teal-text">{item}<span>›</span></div>)}
      <div class="side-list"><span>一覧を見る ›</span></div>
      {['♧　初めての方へ','ⓘ　ヘルプ','♟　新規会員登録'].map(item=><div class="help-row">{item}<span>›</span></div>)}
      <div class="social-panel"><h3>公式SNSアカウント</h3><div class="social-grid">{site.social.slice(0,5).map((item,i)=><div><small>{socialNames[i]}</small><img src={url(item.src!)} alt={socialNames[i]} /></div>)}</div></div>
      <div class="social-panel"><h3>海外公式SNSアカウント</h3><div class="social-grid">{site.social.slice(5,8).map((item,i)=><div><small>{socialNames[i+5]}</small><img src={url(item.src!)} alt={socialNames[i+5]} /></div>)}</div></div>
      <div class="side-video"><img src={url('images/site/dollnuma_title.jpg')} alt="ドル沼 CH" />{site.videos.map(img=><img src={url(img.src!)} alt="ドル沼 CH 第217回" loading="lazy" />)}<small>第217回　2026.09.11配信</small><p>#ドール #アイドール 可愛いを探す旅…！I・Dollさん</p></div>
    </aside>
    <main class="store-main">
      <section class="mobile-showcase mobile-only" aria-label="モバイルのメイン特集">
        <img class="mobile-hero" src={url(mobile.hero)} width="750" height="750" alt="スカーレット・エル・ヴァンディミオン キャストドール 期間限定で受注開始" fetchpriority="high" />
        <div class="mobile-ticker">{mobile.ticker.map(item=><div class="mobile-ticker-item"><img src={url(item.src)} width="74" height="74" alt="" /><p>{item.text}</p></div>)}</div>
      </section>
      <section class="top-showcase" aria-label="最新のお知らせと特集">
        <div class="showcase-main">
          <div class="main-hero"><div class="hero-peek"><img src={url(site.hero[0].src!)} alt="東方Project 博麗霊夢 キャストドール" /></div><img class="hero-center" src={url(site.thumbnails[0].src!)} alt="スカーレット・エル・ヴァンディミオン キャストドール 期間限定で受注開始" fetchpriority="high" /><div class="hero-peek"><img src={url(site.thumbnails[1].src!)} alt="学園アイドルマスター 篠澤 広 キャストドール" /></div></div>
          <div class="carousel-dots" aria-hidden="true">{Array.from({length:13},(_,i)=><span class:list={{active:i===0}} />)}</div>
          <div class="thumbnail-strip"><span class="static-arrow" aria-hidden="true">‹</span>{site.thumbnails.map((item,i)=><article class:list={['thumbnail',{selected:i===0}]}><div class="thumbnail-label">{item.category}</div><img src={url(item.src!)} alt="" /><p>{item.text}</p></article>)}<span class="static-arrow" aria-hidden="true">›</span></div>
          <div class="latest-news"><div class="news-label">最新のお知らせ<span>一覧　 ›</span></div><div class="news-lines">{site.news.map(item=><div><time>{item.date}</time><b>»</b><span>{item.text}</span></div>)}</div></div>
        </div>
        <aside class="showcase-side">{site.side.map((item,i)=><img src={url(item.src!)} alt={['ドル沼チャンネル','オーナーズフォト','夢みる小悪魔 Miss Kitty','NOIR DOLL'][i]} />)}</aside>
      </section>
      <h2 class="mobile-section-heading mobile-topics-heading mobile-only"><img src={url(mobile.topicsHeading)} width="750" height="27" alt="最新トピックス NEW TOPICS" /></h2>
      <section class="banner-grid" aria-label="商品特集バナー">
        {products.map(p=><a class="proposal-banner" href={url(p.slug+'/')} aria-label={`${p.name} の特設ページを見る`}><picture><source media="(max-width: 700px)" srcset={url(`images/banners/${p.slug}-1080x1080.png`)} /><img src={url(`images/banners/${p.slug}-730x135.png`)} width="730" height="135" alt={`${p.name} バナー差し替え用`} /></picture><span class="proposal-caption">{p.name} <span>特設ページへ ›</span></span></a>)}
        {site.banners.map((item,i)=><div class="original-banner"><img src={url(item.src!)} width="730" height="135" alt={`DOLK 商品特集 ${i+1}`} loading="lazy" /></div>)}
        {mobile.topics.map((src,i)=><div class="mobile-topic mobile-only"><img src={url(src)} width="362" height="362" alt={`DOLK モバイル商品特集 ${i+1}`} loading="lazy" /></div>)}
      </section>
      <section class="mobile-campaign-section mobile-only" aria-label="最新企画・キャンペーン情報">
        <h2 class="mobile-section-heading"><img src={url(mobile.campaignHeading)} width="750" height="27" alt="最新企画・キャンペーン情報 CAMPAIGN INFO" loading="lazy" /></h2>
        <div class="mobile-campaign-banners">{mobile.campaigns.map((src,i)=><img src={url(src)} width="730" height="135" alt={['RUCY COTTON CANDY','ドール基本ツール9点セット','オーナーズフォト'][i]} loading="lazy" />)}</div>
      </section>
      <section class="mobile-release mobile-only" aria-label="最新リリース情報">
        <h2><img src={url(mobile.releaseHeading)} width="750" height="100" alt="最新リリース情報 NEW RELEASE INFORMATION" loading="lazy" /></h2>
        <img class="mobile-release-image" src={url(mobile.release.src)} width="710" height="504" alt="DOLL ZONE White New Release 最大15%OFF" loading="lazy" />
        <div class="mobile-release-copy"><span>期間限定受注</span><p class="release-maker">DOLL ZONE</p><p>{mobile.release.text}</p></div>
      </section>
    </main>
  </div>
  <section class="history"><h2>▣ 閲覧履歴 <span>履歴を消す</span></h2><div>現在閲覧履歴はありません。</div></section>
  <footer class="store-footer">
    <div class="footer-content"><div class="footer-category"><strong>商品を探す</strong>{categories.map(item=><span>{item}</span>)}</div><div class="footer-tools"><div><span>メーカー名 ⌃</span><span>おすすめアイテム ⌃</span><span>最新リリース ⌃</span><p>♥ ほしいものリスト　　 │　 ▤ 一覧リスト</p></div><div class="footer-social">{site.social.slice(0,5).map((item,i)=><img src={url(item.src!)} alt={socialNames[i]} loading="lazy" />)}</div><b>🛒 ショッピングカート　 (0点) ¥0　 <small>カートを見る ›</small></b></div><div class="footer-support"><div><strong>お客様サポート</strong><p>› 初めての方へ</p><p>› 新規会員登録</p></div><div><p><span>お買い物ガイド</span> ヘルプ　　 ご注文について　　 お支払い方法について　　 配送・送料について　　 よくあるご質問</p><p><span>会員メニュー</span> 会員ログイン　　 マイページ　　 ID・パスワードを忘れた方　　 ポイントについて</p><p><span>店舗情報</span> DOLK 東京店　　 DOLK 大阪店　　 DOLK ラジオ会館店</p></div></div></div>
    <div class="footer-banners"><span>‹</span>{site.footer.map(item=><img src={url(item.src!)} alt="DOLK キャラクタードール" loading="lazy" />)}<span>›</span></div>
    <div class="copyright"><img src={url('images/site/Logo.png')} alt="DOLK STATION" loading="lazy" /><span>© DOLK STATION / Vodaless,Inc. All rights reserved.</span><span class="legal">特定商取引法表記　 個人情報保護方針　 ご利用規約　 採用情報　 会社概要</span></div>
    <p class="unofficial-note">選考課題として制作した非公式の掲載イメージです。掲載画像・ロゴの権利は各権利者に帰属します。</p>
  </footer>
  <div class="language-display" aria-hidden="true">◎ Language</div>
</Base>
